{
  "name": "zdeck-registry",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static plugin directory for zDeck.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "release": "node --experimental-strip-types scripts/releases.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && python3 -B -m unittest discover -s tests -p 'test_*.py'",
    "submission": "python3 -B scripts/submission.py",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "storybook:build": "storybook build -o storybook-static --disable-telemetry",
    "smoke": "node scripts/smoke.mjs",
    "smoke:directory": "node scripts/directory-smoke.mjs",
    "hosting:smoke": "node scripts/hosting-smoke.mjs",
    "hosting:live": "python3 -B scripts/live_hosting.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.8",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.65.1",
    "storybook": "10.6.8",
    "typescript": "^5.7.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.2"
  }
}
