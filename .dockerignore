# Allowlist: private keys, .env, Git, data, logs, node_modules and build outputs never enter context.
**
!package.json
!package-lock.json
!index.html
!tsconfig.json
!vite.config.ts
!vitest.config.ts
!src/
!src/**
!registry/
!registry/**
!scripts/
!scripts/releases.ts
!tests/
!tests/**
!hosting/
!hosting/nginx.conf
# Also exclude accidental secrets inside otherwise public build-input directories.
**/*.pem
**/*.key
**/.env*
**/.*
!registry/releases/.gitkeep
